+# Experiment only (mattiasgronlund/inari#2), not for merging: `math::det` through inari's
+# correctly rounded `cr::*_rn` instead of `libm` (all but `exp_m1`, `ln_1p` and `powi`).
+det-cr = ["dep:inari"]
 
 [dependencies]
+# Experiment only (feature `det-cr`): inari's default features, no `force-generic`, so its
+# kernel picks its FMA copy at run time on plain x86-64.
+inari = { package = "fushimi", version = "=0.1.0", default-features = false, optional = true }
 # musl's libm (FreeBSD msun; CORE-MATH for cbrt) in Rust, for `math::det`: the same bits on every
 # platform. Pinned exactly: a new release may change a function's last bit, which moves the
 # goldens on every platform at once.
diff --git a/solidcore/crates/solidcore/src/math/det.rs b/solidcore/crates/solidcore/src/math/det.rs
