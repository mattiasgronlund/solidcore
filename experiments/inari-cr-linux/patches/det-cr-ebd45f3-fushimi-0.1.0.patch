 //!
 //! Not upstream (SMLib calls the platform's C library). Deviations: none. No recursion.
 
+// Experiment only (mattiasgronlund/inari#2), not for merging: with feature `det-cr`, every
+// function below but `exp_m1`, `ln_1p` and `powi` calls inari's correctly rounded `cr::*_rn`
+// instead of the `libm` crate. `be!(f, f_rn, args)` names the function in each.
+#[cfg(not(feature = "det-cr"))]
+macro_rules! be {
+    ($libm:ident, $cr:ident, $($a:expr),+) => {
+        libm::$libm($($a),+)
+    };
+}
+#[cfg(feature = "det-cr")]
+macro_rules! be {
+    ($libm:ident, $cr:ident, $($a:expr),+) => {
+        inari::cr::$cr($($a),+)
+    };
+}
+
